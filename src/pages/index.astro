---
import { getCollection, getEntry } from 'astro:content';
import OpeningHours from 'astro-opening-hours/OpeningHours.astro';
import TicketTracker from 'astro-ticket-tracker/TicketTracker.astro';

const ticketEntries = await getCollection('tickets');
const tickets = ticketEntries.map(entry => entry.data);

// Fetch settings from content collections
const generalEntry = await getEntry('generalSettings', 'general');
const general = generalEntry ? generalEntry.data : {
  brandName: "Main Street Shoe Repair",
  subtitle: "Customer Repair Tracker",
  footerText: "© 2026 Main Street Shoe Repair. All rights reserved."
};

const seoEntry = await getEntry('seoSettings', 'seo');
const seo = seoEntry ? seoEntry.data : {
  seoTitle: "Main Street Shoe Repair - Customer Repair Tracker",
  seoDescription: "Track your shoe repairs at Main Street Shoe Repair using our minimalist, real-time repair tracker."
};

const openingHoursEntry = await getEntry('openingHoursSettings', 'openingHours');
const openingHours = openingHoursEntry ? openingHoursEntry.data : null;

function formatName(fullName: string) {
  if (!fullName) return '';
  const parts = fullName.trim().split(/\s+/);
  if (parts.length === 1) return parts[0];
  const firstName = parts[0];
  const lastInitial = parts[parts.length - 1][0].toUpperCase();
  return `${firstName} ${lastInitial}.`;
}
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={seo.seoDescription} />
		<title>{seo.seoTitle}</title>
		
		<!-- Google Fonts Inter -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

		<style>
			:root {
				--bg-color: #f8fafc;
				--card-bg: #ffffff;
				--text-color: #0f172a;
				--text-muted: #64748b;
				--border-color: #e2e8f0;
				--input-bg: #ffffff;
				--input-focus-border: #4f46e5;
				--input-focus-ring: rgba(79, 70, 229, 0.15);
				
				--status-waiting-bg: #fef3c7;
				--status-waiting-text: #b45309;
				--status-waiting-border: #fde68a;
				
				--status-working-bg: #dbeafe;
				--status-working-text: #1d4ed8;
				--status-working-border: #bfdbfe;
				
				--status-ready-bg: #d1fae5;
				--status-ready-text: #047857;
				--status-ready-border: #a7f3d0;

				--shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
				--shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
				--shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1);
				
				--font-sans: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
			}

			@media (prefers-color-scheme: dark) {
				:root {
					--bg-color: #0f172a;
					--card-bg: #1e293b;
					--text-color: #f8fafc;
					--text-muted: #94a3b8;
					--border-color: #334155;
					--input-bg: #1e293b;
					--input-focus-border: #818cf8;
					--input-focus-ring: rgba(129, 140, 248, 0.2);
					
					--status-waiting-bg: rgba(251, 191, 36, 0.1);
					--status-waiting-text: #fbbf24;
					--status-waiting-border: rgba(251, 191, 36, 0.3);
					
					--status-working-bg: rgba(96, 165, 250, 0.1);
					--status-working-text: #60a5fa;
					--status-working-border: rgba(96, 165, 250, 0.3);
					
					--status-ready-bg: rgba(52, 211, 153, 0.1);
					--status-ready-text: #34d399;
					--status-ready-border: rgba(52, 211, 153, 0.3);
				}
			}

			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			body {
				background-color: var(--bg-color);
				color: var(--text-color);
				font-family: var(--font-sans);
				line-height: 1.5;
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
				min-height: 100vh;
				padding: 2rem 1rem;
				display: flex;
				flex-direction: column;
				align-items: center;
				transition: background-color 0.3s ease, color 0.3s ease;
			}

			main {
				width: 100%;
				max-width: 1100px;
				margin: 0 auto;
			}

			header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding-top: 1rem;
				margin-bottom: 2rem;
				width: 100%;
			}

			.header-left {
				display: flex;
				align-items: center;
				gap: 1.25rem;
			}

			.logo-container {
				background: #3b6bb8;
				color: white;
				width: 3rem;
				height: 3rem;
				border-radius: 0.75rem;
				display: flex;
				align-items: center;
				justify-content: center;
				box-shadow: var(--shadow-sm);
				flex-shrink: 0;
			}

			.logo-icon {
				width: 1.5rem;
				height: 1.5rem;
			}

			.header-text {
				display: flex;
				flex-direction: column;
				text-align: left;
			}

			h1 {
				font-size: 1.35rem;
				font-weight: 700;
				color: #1e293b;
				margin: 0;
				line-height: 1.2;
			}

			.subtitle {
				font-size: 0.875rem;
				color: #475569;
				font-weight: 500;
				margin-top: 0.15rem;
			}

			.card {
				background-color: var(--card-bg);
				border: 1px solid var(--border-color);
				border-radius: 1rem;
				box-shadow: var(--shadow-lg);
				padding: 1.5rem;
				margin-bottom: 2rem;
				transition: border-color 0.3s ease, background-color 0.3s ease;
			}

			.search-bar-container {
				margin-bottom: 1.5rem;
				display: flex;
				flex-direction: column;
				gap: 0.75rem;
			}

			.search-wrapper {
				position: relative;
				display: flex;
				align-items: center;
			}

			.search-icon-svg {
				position: absolute;
				left: 1rem;
				width: 1.25rem;
				height: 1.25rem;
				color: var(--text-muted);
				pointer-events: none;
			}

			.search-input {
				width: 100%;
				padding: 0.875rem 2.75rem 0.875rem 2.75rem;
				font-size: 1rem;
				font-family: inherit;
				color: var(--text-color);
				background-color: var(--input-bg);
				border: 1px solid var(--border-color);
				border-radius: 0.75rem;
				outline: none;
				box-shadow: var(--shadow-sm);
				transition: border-color 0.2s ease, box-shadow 0.2s ease;
			}

			.search-input:focus {
				border-color: var(--input-focus-border);
				box-shadow: var(--shadow-sm), 0 0 0 4px var(--input-focus-ring);
			}

			.search-input::placeholder {
				color: var(--text-muted);
				opacity: 0.8;
			}

			.clear-search-btn {
				position: absolute;
				right: 0.875rem;
				background: none;
				border: none;
				padding: 0.25rem;
				color: var(--text-muted);
				cursor: pointer;
				border-radius: 50%;
				display: none;
				align-items: center;
				justify-content: center;
				transition: color 0.15s ease, background-color 0.15s ease;
			}

			.clear-search-btn:hover {
				color: var(--text-color);
				background-color: var(--border-color);
			}

			.clear-search-btn svg {
				width: 1.125rem;
				height: 1.125rem;
			}

			.info-strip {
				display: flex;
				justify-content: space-between;
				align-items: center;
				font-size: 0.875rem;
				color: var(--text-muted);
				font-weight: 500;
				border-bottom: 1px solid var(--border-color);
				padding-bottom: 0.75rem;
				margin-bottom: 0.75rem;
			}

			.table-container {
				overflow-x: auto;
				width: 100%;
			}

			table {
				width: 100%;
				border-collapse: collapse;
				text-align: left;
				font-size: 0.95rem;
			}

			th {
				font-weight: 600;
				color: var(--text-muted);
				padding: 1rem 1.5rem;
				border-bottom: 1px solid var(--border-color);
				font-size: 0.85rem;
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}

			td {
				padding: 1.25rem 1.5rem;
				border-bottom: 1px solid var(--border-color);
				color: var(--text-color);
				vertical-align: middle;
			}

			tr:last-child td {
				border-bottom: none;
			}

			tr {
				transition: background-color 0.15s ease;
			}

			tbody tr:not(#no-results):hover {
				background-color: rgba(0, 0, 0, 0.02);
			}

			@media (prefers-color-scheme: dark) {
				tbody tr:not(#no-results):hover {
					background-color: rgba(255, 255, 255, 0.02);
				}
			}

			.ticket-num {
				font-family: monospace;
				font-weight: 700;
				font-size: 1rem;
				color: var(--text-color);
			}

			.ticket-date {
				color: var(--text-muted);
				font-size: 0.875rem;
			}

			.shoe-desc {
				font-weight: 500;
			}

			.customer-name {
				font-weight: 600;
				color: var(--text-color);
			}

			.badge {
				display: inline-flex;
				align-items: center;
				padding: 0.25rem 0.75rem;
				font-size: 0.75rem;
				font-weight: 600;
				border-radius: 9999px;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				border: 1px solid transparent;
				line-height: 1.2;
			}

			.badge-waiting {
				background-color: var(--status-waiting-bg);
				color: var(--status-waiting-text);
				border-color: var(--status-waiting-border);
			}

			.badge-working {
				background-color: var(--status-working-bg);
				color: var(--status-working-text);
				border-color: var(--status-working-border);
			}

			.badge-ready {
				background-color: var(--status-ready-bg);
				color: var(--status-ready-text);
				border-color: var(--status-ready-border);
			}

			#no-results {
				display: none;
			}

			.no-results-box {
				text-align: center;
				padding: 3rem 1rem;
				color: var(--text-muted);
			}

			/* Mobile Card view styles */
			.cards-container {
				display: none;
			}

			.ticket-card {
				background-color: var(--card-bg);
				border: 1px solid var(--border-color);
				border-radius: 0.75rem;
				padding: 1rem;
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
				box-shadow: var(--shadow-sm);
				transition: border-color 0.2s ease, background-color 0.2s ease;
			}

			.card-header-row {
				display: flex;
				justify-content: space-between;
				align-items: center;
				border-bottom: 1px dashed var(--border-color);
				padding-bottom: 0.5rem;
				margin-bottom: 0.25rem;
			}

			.card-body-row {
				display: flex;
				flex-direction: column;
				gap: 0.25rem;
			}

			.card-label {
				font-size: 0.75rem;
				text-transform: uppercase;
				color: var(--text-muted);
				font-weight: 600;
				letter-spacing: 0.05em;
			}

			#no-results-mobile {
				display: none;
			}

			@media (max-width: 600px) {
				.table-container {
					display: none;
				}
				.cards-container {
					display: flex;
					flex-direction: column;
					gap: 1rem;
				}
				header {
					margin-bottom: 1.25rem;
					justify-content: center;
				}
				.header-left {
					gap: 0.75rem;
				}
				.logo-container {
					width: 2.5rem;
					height: 2.5rem;
					border-radius: 0.5rem;
				}
				.logo-icon {
					width: 1.35rem;
					height: 1.35rem;
				}
				h1 {
					font-size: 1.25rem;
				}
				.subtitle {
					font-size: 0.8rem;
					margin-top: 0.05rem;
				}
			}

			.no-results-icon {
				width: 3rem;
				height: 3rem;
				margin-bottom: 0.75rem;
				color: var(--text-muted);
				opacity: 0.5;
			}

			footer {
				text-align: center;
				margin-top: auto;
				padding-top: 2rem;
				font-size: 0.875rem;
				color: var(--text-muted);
				border-top: 1px solid var(--border-color);
				width: 100%;
				max-width: 1100px;
			}

			/* Subtle custom animation on hover */
			.logo-container:hover .logo-icon {
				transform: rotate(-10deg) scale(1.05);
				transition: transform 0.2s ease;
			}

			.header-right {
				flex-shrink: 0;
			}

			@media (prefers-color-scheme: dark) {
				h1 {
					color: #f8fafc;
				}
				.subtitle {
					color: #94a3b8;
				}
			}
		</style>
	</head>
	<body>
		<main>
			<header>
				<div class="header-left">
					<div class="logo-container">
						<!-- Clean modern arrow logo -->
						<svg class="logo-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
							<line x1="5" y1="12" x2="19" y2="12"></line>
							<polyline points="12 5 19 12 12 19"></polyline>
						</svg>
					</div>
					<div class="header-text">
						<h1>{general.brandName}</h1>
						<p class="subtitle">{general.subtitle}</p>
					</div>
				</div>
				<div class="header-right">
					{openingHours && (
						<OpeningHours 
							config={openingHours} 
							businessName={general.brandName} 
							dayFormat="long" 
							timeFormat="12h" 
						/>
					)}
				</div>
			</header>

			<section class="card">
				<TicketTracker tickets={tickets} />
			</section>

			<footer>
				<p>{general.footerText}</p>
			</footer>
		</main>
	</body>
</html>
